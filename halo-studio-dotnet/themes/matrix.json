      {
        "op": "line",
        "x": 157,
        "y": 1,
        "x2": 157,
        "y2": 31,
        "when": "=valid*instrument"
      },
      {
        "op": "line",
        "x": 157,
        "y": 16,
        "x2": "=157+round(cos(phase*pi/4)*13)",
        "y2": "=16+round(sin(phase*pi/4)*13)",
