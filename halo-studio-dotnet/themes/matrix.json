      },
      {
        "op": "erase",
        "x": 140,
        "y": 1,
        "w": 116,
        "h": 31,
        "when": "=1-valid"
      },
      {
        "op": "small",
        "text": "NO SENSOR",
        "x": 147,
        "y": 12,
        "when": "=1-valid"
      }
