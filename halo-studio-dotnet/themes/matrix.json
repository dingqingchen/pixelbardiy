        "commands": [
          {
            "op": "rect",
            "x": "=39+i*4",
            "y": 1,
            "w": 1,
            "h": 1,
            "fill": true
          }
        ],
        "var": "i",
        "start": 0,
        "step": 1
      },
      {
        "op": "rect",
        "x": 243,
        "y": 19,
        "w": 10,
        "h": 3,
        "fill": true,
        "when": "=1-phase%2"
      },
      {
        "op": "line",
        "x": 38,
        "y": 30,
        "x2": 255,
        "y2": 30
      }
    ],
