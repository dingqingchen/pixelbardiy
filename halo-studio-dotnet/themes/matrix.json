      {
        "op": "repeat",
        "count": 4,
        "commands": [
          {
            "op": "repeat",
            "count": 6,
            "commands": [
              {
                "op": "rect",
                "x": "=220+i*6",
                "y": "=row*8",
                "w": 4,
                "h": 5,
                "fill": true,
                "when": "=(i+row+phase)%3"
              }
            ],
            "var": "i",
            "start": 0,
            "step": 1
          }
        ],
        "var": "row",
        "start": 0,
        "step": 1
      }
    ],
